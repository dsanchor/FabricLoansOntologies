# =============================================================================
# Configuracion para scripts/deploy_to_fabric.py
# -----------------------------------------------------------------------------
# 1. Copia este archivo a ".env"  ->  cp .env.example .env
# 2. Rellena los valores marcados como OBLIGATORIO.
# 3. NUNCA subas el .env real al repo (ya esta en .gitignore).
# =============================================================================

# --- Identidad / Azure AD ---------------------------------------------------
# GUID de tu tenant de Azure (Entra ID > Overview > Tenant ID). OBLIGATORIO.
FABRIC_TENANT_ID=

# Metodo de autenticacion: interactive | device | cli
#   interactive -> abre el navegador (recomendado en equipos de escritorio)
#   device      -> muestra un codigo para pegar en https://microsoft.com/devicelogin
#   cli         -> reutiliza la sesion de "az login" (requiere Azure CLI instalada)
FABRIC_AUTH_METHOD=interactive

# --- Destino en Fabric ------------------------------------------------------
# GUID del workspace destino. Lo ves en la URL de Fabric:
#   https://app.fabric.microsoft.com/groups/<ESTE-GUID>/...   OBLIGATORIO.
FABRIC_TARGET_WORKSPACE_ID=

# Nombre del Lakehouse destino que se creara (o reutilizara si ya existe).
FABRIC_TARGET_LAKEHOUSE_NAME=Gold_AnalyzeLoanV3_Target

# Crear el lakehouse si no existe (true/false).
FABRIC_CREATE_LAKEHOUSE_IF_MISSING=true

# Habilitar esquemas en el lakehouse (la ontologia usa el esquema "dbo").
FABRIC_LAKEHOUSE_ENABLE_SCHEMAS=true

# Esquema destino para las tablas.
FABRIC_TARGET_SCHEMA=dbo

# --- Origen de datos (ZIPs locales del repo) --------------------------------
# Carpeta con los ZIPs de tablas Delta. Relativa a la raiz del repo.
FABRIC_ZIPS_DIR=data_snapshots/gold/zips

# Lista de tablas a desplegar, separadas por coma.
# Deben coincidir con el nombre del archivo <tabla>.zip dentro de FABRIC_ZIPS_DIR.
FABRIC_TABLES=dim_loan,dim_prev_application,dim_relative_month,dim_dpd_bucket_v2,fact_pos_cash_monthly_balance_v2

# Carpeta temporal donde se extraen los ZIPs y se convierten a Delta.
# Si se deja vacio, se usa el directorio temporal del sistema (ej. /tmp), lo
# cual es IMPORTANTE en WSL/OneDrive: escribir parquet en rutas /mnt/c/...
# sincronizadas provoca errores "Upload aborted". Solo pon una ruta aqui si
# sabes que tu filesystem local lo soporta.
FABRIC_WORKDIR=
